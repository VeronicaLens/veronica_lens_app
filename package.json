{
  "name": "veronica_lens_app",
  "version": "0.1.0",
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@expo/log-box": "57.0.4",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@react-native-vector-icons/lucide": "13.1.3",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.20",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sensors": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-vision-camera": "5.2.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.4.0",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:dev:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "android:dev": "expo run:android",
    "build:android:dev": "npx eas-cli@23.2.0 build --platform android --profile development",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/shared/config/env.test.ts src/shared/api/connectivity.test.ts src/features/auth/api/auth-api.test.ts src/features/auth/lib/recovery-link.test.ts src/features/auth/model/session-storage.test.ts src/features/auth/model/session-refresh.test.ts src/features/profile/api/profile-api.test.ts src/features/notifications/api/notifications-api.test.ts src/features/notifications/lib/notification-event-link.test.ts src/features/device-orientation/model/orientation.test.ts src/features/device-orientation/model/device-orientation.service.test.ts src/features/celestial-projection/model/celestial-projection.test.ts src/features/sky-guide/api/sky-guide-api.test.ts src/features/observation-planning/api/observation-planning-api.test.ts src/features/observation-history/api/observation-history-api.test.ts src/features/astronomical-events/api/events-api.test.ts src/features/astronomical-events/lib/event-link.test.ts src/features/camera-capture/model/camera-capture.test.ts src/features/camera-capture/model/camera-capabilities.test.ts src/features/astrophoto-storage/model/astrophoto-sync.test.ts",
    "contract:generate": "openapi-ts",
    "contract:check": "npm run contract:generate && node scripts/check-generated-contract.mjs",
    "bundle:android": "expo export --platform android --output-dir dist",
    "validate": "npm run contract:check && npm run lint && npm run format:check && npm run typecheck && npm run test && npm run bundle:android"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  },
  "private": true
}
