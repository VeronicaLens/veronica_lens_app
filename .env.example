# Em dispositivo físico, substitua localhost pelo IP do computador na rede local.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# Client ID do tipo "Web application" criado no Google Cloud Console (mesmo client usado no
# provedor Google do Supabase Auth). Necessário apenas para habilitar "Continuar com Google".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# URL https pública da política de privacidade (obrigatória para publicar na Google Play).
# Quando preenchida, aparece em "Dados e privacidade" e "Sobre o VeronicaLens".
EXPO_PUBLIC_PRIVACY_POLICY_URL=

